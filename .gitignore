# ============================================================
# Git Ignore Configuration
# ============================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Databases & Local Storage
*.sqlite
*.sqlite3
*.db
backend/data/*.sqlite3
backend/data/*.db
!backend/data/.gitkeep

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# MCP, Testing & Test Artifacts
.playwright-mcp/
playwright-report/
test-results/

# Editor & OS files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log