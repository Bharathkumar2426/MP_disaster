# Disaster Management System - Root Environment Template
# Copy to backend/.env and update values for local execution.

# Database Configuration (SQLite default for dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./data/disaster_db.sqlite3

# Security & JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key for RakshaBot
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Open-Meteo & External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
GDACS_FEED_URL=https://www.gdacs.org/gdacsapi/api/Events/geteventlist/EVENTS4APP
GDACS_POLL_INTERVAL_SECONDS=300

# Service URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
